{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "六组对照实验配置",
  "type": "object",
  "required": ["board_name", "groups", "metrics", "cost_model"],
  "additionalProperties": false,
  "properties": {
    "board_name": { "type": "string", "minLength": 2, "maxLength": 80 },
    "groups": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["group_id", "label", "baseline"],
        "additionalProperties": false,
        "properties": {
          "group_id": { "type": "string", "pattern": "^grp-[a-z0-9-]{2,31}$" },
          "label": { "type": "string", "minLength": 2 },
          "baseline": { "type": "boolean", "description": "是否基准组（对照组）" }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric", "direction"],
        "additionalProperties": false,
        "properties": {
          "metric": { "type": "string", "minLength": 2 },
          "direction": { "type": "string", "enum": ["higher_is_better", "lower_is_better"] }
        }
      }
    },
    "cost_model": {
      "type": "object",
      "required": ["unit_price_usd", "currency"],
      "additionalProperties": false,
      "properties": {
        "unit_price_usd": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^USD$" },
        "note": { "type": "string" }
      }
    }
  }
}